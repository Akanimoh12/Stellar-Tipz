    {
      "id": 11,
      "type": "timeseries",
      "title": "System failure ratio per operation",
      "description": "Failures the platform caused (RPC, database, keeper). Alerts key off these, never off user errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tipz_tips_total{result=\"system_error\"}[10m])) / clamp_min(sum(rate(tipz_tips_total[10m])), 0.001)",
          "legendFormat": "tips"
        },
        {
          "refId": "B",
          "expr": "sum(rate(tipz_withdrawals_total{result=\"system_error\"}[10m])) / clamp_min(sum(rate(tipz_withdrawals_total[10m])), 0.001)",
          "legendFormat": "withdrawals"
        },
        {
          "refId": "C",
          "expr": "sum(rate(tipz_subscription_charges_total{result=\"system_error\"}[1h])) / clamp_min(sum(rate(tipz_subscription_charges_total[1h])), 0.0001)",
          "legendFormat": "subscription charges"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "User-caused failures per operation",
