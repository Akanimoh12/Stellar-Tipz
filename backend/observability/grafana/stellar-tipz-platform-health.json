          "legendFormat": "today"
        },
        {
          "refId": "B",
          "expr": "sum(rate(tipz_tips_total{result=\"success\"}[5m] offset 1d)) * 60",
          "legendFormat": "yesterday"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
