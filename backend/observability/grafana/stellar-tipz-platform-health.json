      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tipz_withdrawals_total{result=\"success\"}[1h])) * 3600",
          "legendFormat": "withdrawals/h"
