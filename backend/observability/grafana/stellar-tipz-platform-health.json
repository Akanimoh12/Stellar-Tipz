    {
      "id": 6,
      "type": "timeseries",
      "title": "Tips by source and result",
      "description": "api = POST /tips, indexer = on-chain event. duplicate is idempotent replay, not a failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, result) (rate(tipz_tips_total[5m])) * 60",
          "legendFormat": "{{source}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 25
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tips: today vs yesterday",
      "description": "",
      "datasource": {
        "type": "prometheus",
