{
  "title": "Stellar Tipz Database Health",
  "uid": "tipz-db-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "DB sessions",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (state) (tipz_db_connections)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 query latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tipz_db_query_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Lock waiters",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(tipz_db_lock_waiting_sessions)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Dead tuple ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "tipz_db_dead_tuple_ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Table storage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "tipz_db_table_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Index storage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "tipz_db_index_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Top ranked query time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "tipz_db_top_query_total_exec_seconds",
          "refId": "A"
        }
      ]
    }
  ]
}
