// Stellar Tipz — Prisma schema
//
// This is the STARTER schema. Most models are added/extended by individual issues
// (see the "data model" issues). Run `npm run prisma:migrate` after changing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A creator/user identified by their Stellar wallet address.
/// Extended by credit, tips and other modules in later issues.
model User {
  deletedAt DateTime?
  id             String   @id @default(cuid())
  stellarAddress String   @unique
  username       String?  @unique
  displayName    String?
  bio            String?
  imageUrl       String?
  avatarCid      String?
  xHandle        String?
  role           String   @default("user")
  scopes         String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sentTips Tip[] @relation("SentTips")
  receivedTips Tip[] @relation("ReceivedTips")
  notifications Notification[]
  notificationPreference NotificationPreference?
  notificationBatches NotificationBatch[]
  notificationDeliveries NotificationDelivery[]
  notificationChannels NotificationChannelState[]
  leaderboardSnapshots LeaderboardSnapshot[]
  streak Streak?
  apiKeys        ApiKey[]
  refreshTokens  RefreshToken[]
  goals          Goal[]

  tipperSubscriptions  Subscription[]        @relation("SubscriptionTipper")
  creatorSubscriptions Subscription[]        @relation("SubscriptionCreator")
  webhookSubscriptions WebhookSubscription[]
}

/// API key for service/admin access and webhook integrations.
model ApiKey {
  deletedAt DateTime?
  id          String   @id @default(cuid())
  hashedKey   String   @unique
  scopes      String[]
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

enum TipStatus {
  CONFIRMED
  PENDING
  REFUNDED
}

/// On-chain tip mirrored off-chain by the indexer.
/// Fields and relations are expanded in the tips/indexer issues.
model Tip {
  id            String    @id @default(cuid())
  txHash        String    @unique
  ledger        Int
  fromAddress   String
  toAddress     String
  amountStroops BigInt
  networkFee    BigInt    @default(0)
  tokenCode     String    @default("XLM")
  isAnonymous   Boolean   @default(false)
  status        TipStatus @default(PENDING)
  message       String?
  createdAt     DateTime  @default(now())

  senderId    String?
  sender      User?   @relation("SentTips", fields: [senderId], references: [id])
  recipientId String?
  recipient   User?   @relation("ReceivedTips", fields: [recipientId], references: [id])

  refund Refund?
}

/// Tracks indexer progress per event topic so it can resume after a restart.
model IndexerCursor {
  topic      String   @id
  lastLedger Int
  updatedAt  DateTime @updatedAt
}

/// Refund requests tied to a specific tip.
model Refund {
  id        String   @id @default(cuid())
  tipId     String   @unique
  tip       Tip      @relation(fields: [tipId], references: [id])
  amount    BigInt
  reason    String
  status    String   @default("pending")
  txHash    String?
  createdAt DateTime @default(now())
}

/// In-app notification for a user.
model Notification {
  deletedAt DateTime?
  deliveries NotificationDelivery[]
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Cached X (Twitter) account metrics.
model XAccount {
  id         String   @id @default(cuid())
  handle     String   @unique
  followers  Int      @default(0)
  engagement Float?
  fetchedAt  DateTime @default(now())
}

/// Leaderboard period tracked by snapshots.
enum Period {
  WEEKLY
  MONTHLY
  ALL_TIME
}

/// Periodic leaderboard snapshot entry for fast reads and historical ranking.
model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  period    Period
  rank      Int
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  totalTips BigInt
  createdAt DateTime @default(now())
}

/// Per-user tipping streak tracking. One row per user (userId is unique).
model Streak {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastTipDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Short-lived wallet authentication challenge.
/// Created when a wallet requests a sign-in nonce; deleted (or expired) after verification.
/// TTL is enforced by the application layer via AUTH_CHALLENGE_TTL_SECONDS.
model AuthChallenge {
  id             String    @id @default(cuid())
  /// The wallet address this challenge was issued for.
  stellarAddress String
  /// Random nonce the wallet must sign to prove ownership.
  challenge      String    @unique
  /// Network this challenge is bound to (TESTNET, FUTURENET, MAINNET).
  network        String
  /// UTC timestamp after which the challenge is no longer valid.
  expiresAt      DateTime
  /// UTC timestamp when the challenge was successfully used (null if unused).
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([stellarAddress])
  @@index([expiresAt])
}

/// Refresh token issued on login, stored hashed for rotation/revocation.
/// The raw token value is never persisted — only its hash is stored here.
model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

/// Lifecycle status of a creator funding goal.
enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Creator-defined funding goal tracked against incoming tips.
model Goal {
  version Int @default(0)
  deletedAt DateTime?
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  targetStroops BigInt
  raisedStroops BigInt     @default(0)
  deadline      DateTime?
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
}

/// Billing cadence for a recurring tip subscription.
enum SubscriptionInterval {
  DAILY
  WEEKLY
  MONTHLY
}

/// Lifecycle status of a recurring tip subscription.
enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
  FAILED
}

/// Recurring tip agreement between a tipper and a creator.
model Subscription {
  pendingAmountStroops BigInt?
  pendingInterval SubscriptionInterval?
  changeEffectiveAt DateTime?
  deletedAt DateTime?
  id            String               @id @default(cuid())
  tipperId      String
  tipper        User                 @relation("SubscriptionTipper", fields: [tipperId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       User                 @relation("SubscriptionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  amountStroops BigInt
  interval      SubscriptionInterval
  nextChargeAt  DateTime
  status        SubscriptionStatus   @default(ACTIVE)
  chargeFailureCount       Int       @default(0)
  dunningStartedAt         DateTime?
  nextChargeRetryAt        DateTime?
  lastChargeFailureReason  String?
  chargeAttemptStartedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tipperId])
  @@index([creatorId])
  @@index([nextChargeAt])
  @@index([status, nextChargeAt])
  @@index([status, nextChargeRetryAt])
}

enum WebhookSubscriptionStatus {
  ACTIVE
  DISABLED
}

/// Outbound webhook subscription owned by one authenticated user.
model WebhookSubscription {
  id                      String                    @id @default(cuid())
  ownerId                 String
  owner                   User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url                     String
  secret                  String
  previousSecret          String?
  previousSecretExpiresAt DateTime?
  events                  String[]
  status                  WebhookSubscriptionStatus @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  deliveries              WebhookDelivery[]

  @@index([ownerId])
}

/// Delivery state of a single webhook notification attempt.
enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

/// A single delivery attempt for an outbound webhook subscription.
model WebhookDelivery {
  id             String                @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status         WebhookDeliveryStatus @default(PENDING)
  responseCode   Int?
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  attemptHistory WebhookDeliveryAttempt[]

  @@index([subscriptionId])
  @@index([status, nextAttemptAt])
}


/// Bounded diagnostic data for one HTTP delivery attempt.
model WebhookDeliveryAttempt {
  id                  String          @id @default(cuid())
  deliveryId          String
  delivery            WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber       Int
  responseCode        Int?
  responseBodyExcerpt String?
  errorReason         String?
  attemptedAt         DateTime        @default(now())

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, attemptedAt])
}

/// Audit log for tracking sensitive actions and job execution (issues #1289, #1288, #1287).
/// Records money-moving and state-mutating operations with full context for compliance.
model AuditLog {
  id           String   @id @default(cuid())
  /// Type of action: "api_call", "job_execution", "subscription_charge", etc.
  action       String
  /// Actor type: "user" or "system".
  actorType    String
  /// Actor ID: user ID or job name.
  actorId      String
  /// Trigger type: "manual" (API), "scheduled" (cron), or "triggered" (external).
  trigger      String   @default("manual")
  /// Stringified input parameters.
  input        Json
  /// Outcome: "success" or "failure".
  outcome      String
  /// Error message if outcome is "failure".
  error        String?
  /// Execution duration in milliseconds.
  durationMs   Int?
  /// Associated resource ID if applicable (e.g., subscription ID, tip ID).
  resourceId   String?
  /// Resource type being acted upon.
  resourceType String?
  createdAt    DateTime @default(now())

  @@index([actorType, actorId])
  @@index([action])
  @@index([outcome])
  @@index([createdAt])
  @@index([resourceId])
}

/// Queue metrics snapshot for monitoring and autoscaling (issue #1287).
/// Periodic snapshots of queue depth to enable autoscaling and performance monitoring.
model QueueMetric {
  id               String   @id @default(cuid())
  /// Queue name (e.g., "subscription-charge", "ipfs-pin").
  queueName        String
  /// Number of jobs waiting to be processed.
  waitingCount     Int
  /// Number of jobs currently being processed.
  activeCount      Int
  /// Number of delayed jobs.
  delayedCount     Int
  /// Number of failed jobs.
  failedCount      Int
  /// Age of oldest waiting job in seconds (null if no waiting jobs).
  oldestWaitingAge Int?
  createdAt        DateTime @default(now())

  @@index([queueName, createdAt])
  @@index([createdAt])
}

model NotificationPreference {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipReceived Boolean @default(true)
  goalReached Boolean @default(true)
  subscriptionCharged Boolean @default(true)
  payoutFailed Boolean @default(true)
  batchingEnabled Boolean @default(false)
  batchingWindowSeconds Int @default(300)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationBatch {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  tokenCode String
  count Int @default(0)
  totalStroops BigInt @default(0)
  dueAt DateTime
  @@index([dueAt])
}

enum NotificationChannel {
  in_app
  email
  push
}

enum NotificationDeliveryStatus {
  queued
  sent
  delivered
  failed
  bounced
}

model NotificationDelivery {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String?
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  status NotificationDeliveryStatus @default(queued)
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([channel, status])
  @@index([notificationId])
}

model NotificationChannelState {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  consecutiveFailures Int @default(0)
  disabledAt DateTime?
  @@id([userId, channel])
}

/// Existing event-log table restored from migrations for subscription projections.
model EventLog {
  id String @id @default(cuid())
  topic String
  ledger Int
  txHash String
  data Json
  createdAt DateTime @default(now())
  @@index([topic])
  @@index([ledger])
  @@index([txHash])
}
