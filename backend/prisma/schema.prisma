/**
 * auth/signature.ts
 *
 * Hardened Stellar wallet sign-in challenge flow.
 *
 * ASSUMPTIONS (adjust import paths to match your actual project layout):
 *   - Prisma client singleton exported from "../lib/prisma" as `prisma`.
 *   - Redis client (ioredis) singleton exported from "../lib/redis" as `redis`,
 *     reused from the BullMQ setup already in this repo.
 *   - Stellar signature verification via `@stellar/stellar-sdk` (Keypair.verify).
 *   - Caller (route handler / middleware) passes the requester's IP address in.
 *
 * Security properties implemented:
 *   1. Signed payload binds domain + network + nonce + address + expiry,
 *      so a signature can't be replayed on another domain/network or reused
 *      past its TTL.
 *   2. Single-use, race-free consumption: verification and deletion happen
 *      in one atomic `deleteMany` — under concurrent requests only one can
 *      ever match and delete the row, so double-spending a valid signature
 *      is not possible even if two verify calls race.
 *   3. Constant-time comparison for any raw secret/string comparison
 *      (the nonce itself is only ever compared via the DB query, but this
 *      guards any additional shared-secret checks, e.g. HMAC secrets).
 *   4. Expiry pruning job to keep the table small and bounded.
 *   5. Per-address and per-IP rate limiting on challenge issuance to stop
 *      enumeration / flooding.
 */
 
import { randomBytes, timingSafeEqual } from "crypto";
import { Keypair } from "@stellar/stellar-sdk";
import { prisma } from "../lib/prisma";
import { redis } from "../lib/redis";
 
// ---------------------------------------------------------------------------
// Config
// ---------------------------------------------------------------------------
 
/** How long an issued challenge remains valid. */
const AUTH_CHALLENGE_TTL_SECONDS = Number(
  process.env.AUTH_CHALLENGE_TTL_SECONDS ?? 300, // 5 minutes
);
 
/** The domain that must be embedded in the signed payload (anti cross-site replay). */
const AUTH_DOMAIN = process.env.AUTH_DOMAIN ?? "stellartipz.app";
 
/** Networks we accept challenges for. Extend as needed. */
const ALLOWED_NETWORKS = new Set(["TESTNET", "FUTURENET", "MAINNET"]);
 
/** Rate limit: max challenges an address may request per window. */
const RATE_LIMIT_MAX_PER_ADDRESS = Number(
  process.env.AUTH_RATE_LIMIT_MAX_PER_ADDRESS ?? 5,
);
/** Rate limit: max challenges a single IP may request per window. */
const RATE_LIMIT_MAX_PER_IP = Number(
  process.env.AUTH_RATE_LIMIT_MAX_PER_IP ?? 20,
);
const RATE_LIMIT_WINDOW_SECONDS = Number(
  process.env.AUTH_RATE_LIMIT_WINDOW_SECONDS ?? 60,
);
 
// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------
 
export class AuthChallengeError extends Error {
  constructor(
    message: string,
    public readonly code:
      | "RATE_LIMITED"
      | "INVALID_NETWORK"
      | "INVALID_OR_EXPIRED_CHALLENGE"
      | "INVALID_SIGNATURE",
  ) {
    super(message);
    this.name = "AuthChallengeError";
  }
}
 
// ---------------------------------------------------------------------------
// Rate limiting (fixed-window counter in Redis; simple and race-safe via INCR)
// ---------------------------------------------------------------------------
 
async function checkAndIncrementRateLimit(
  key: string,
  max: number,
): Promise<void> {
  const redisKey = `authchallenge:ratelimit:${key}`;
  const count = await redis.incr(redisKey);
  if (count === 1) {
    // First hit in this window — set expiry.
    await redis.expire(redisKey, RATE_LIMIT_WINDOW_SECONDS);
  }
  if (count > max) {
    throw new AuthChallengeError(
      "Too many challenge requests. Please try again shortly.",
      "RATE_LIMITED",
    );
  }
}
 
// ---------------------------------------------------------------------------
// Canonical signed payload
// ---------------------------------------------------------------------------
 
/**
 * Builds the exact string the wallet must sign. Binding domain, network,
 * address and nonce together prevents:
 *   - replaying a signature obtained by a phishing/lookalike domain
 *   - replaying a signature across networks (e.g. TESTNET sig on MAINNET)
 *   - swapping in a different address's challenge
 */
function buildSignedPayload(params: {
  domain: string;
  network: string;
  stellarAddress: string;
  nonce: string;
  expiresAtIso: string;
}): string {
  const { domain, network, stellarAddress, nonce, expiresAtIso } = params;
  return [
    `domain: ${domain}`,
    `network: ${network}`,
    `address: ${stellarAddress}`,
    `nonce: ${nonce}`,
    `expires: ${expiresAtIso}`,
  ].join("\n");
}
 
/** Constant-time string equality, for any raw secret comparisons. */
function constantTimeStringEqual(a: string, b: string): boolean {
  const bufA = Buffer.from(a, "utf8");
  const bufB = Buffer.from(b, "utf8");
  if (bufA.length !== bufB.length) {
    // Still run timingSafeEqual against a same-length buffer so the
    // comparison doesn't short-circuit on length alone in a way that
    // leaks more than necessary; the length check above is unavoidable
    // since timingSafeEqual requires equal-length buffers.
    return false;
  }
  return timingSafeEqual(bufA, bufB);
}
 
// ---------------------------------------------------------------------------
// Issue a challenge
// ---------------------------------------------------------------------------
 
export async function createAuthChallenge(params: {
  stellarAddress: string;
  network: string;
  requestIp: string;
}): Promise<{ nonce: string; payload: string; expiresAt: Date }> {
  const { stellarAddress, network, requestIp } = params;
 
  if (!ALLOWED_NETWORKS.has(network)) {
    throw new AuthChallengeError(`Unsupported network: ${network}`, "INVALID_NETWORK");
  }
 
  await checkAndIncrementRateLimit(`addr:${stellarAddress}`, RATE_LIMIT_MAX_PER_ADDRESS);
  await checkAndIncrementRateLimit(`ip:${requestIp}`, RATE_LIMIT_MAX_PER_IP);
 
  const nonce = randomBytes(32).toString("hex");
  const expiresAt = new Date(Date.now() + AUTH_CHALLENGE_TTL_SECONDS * 1000);
 
  await prisma.authChallenge.create({
    data: {
      stellarAddress,
      challenge: nonce,
      network,
      expiresAt,
    },
  });
 
  const payload = buildSignedPayload({
    domain: AUTH_DOMAIN,
    network,
    stellarAddress,
    nonce,
    expiresAtIso: expiresAt.toISOString(),
  });
 
  return { nonce, payload, expiresAt };
}
 
// ---------------------------------------------------------------------------
// Verify + atomically consume a challenge
// ---------------------------------------------------------------------------
 
export async function verifyAuthChallenge(params: {
  stellarAddress: string;
  network: string;
  nonce: string;
  signatureBase64: string;
}): Promise<{ success: true }> {
  const { stellarAddress, network, nonce, signatureBase64 } = params;
 
  if (!ALLOWED_NETWORKS.has(network)) {
    throw new AuthChallengeError(`Unsupported network: ${network}`, "INVALID_NETWORK");
  }
 
  // Atomic single-use consumption: this DELETE only removes a row if it
  // still exists, matches address+network+nonce, and hasn't expired.
  // deleteMany's WHERE + DELETE happens atomically at the DB level, so under
  // concurrent verify attempts for the same nonce, exactly one caller will
  // see `count === 1` and every other caller will see `count === 0` — there
  // is no window in which two requests can both "win".
  const { count } = await prisma.authChallenge.deleteMany({
    where: {
      stellarAddress,
      network,
      challenge: nonce,
      expiresAt: { gt: new Date() },
    },
  });
 
  if (count !== 1) {
    throw new AuthChallengeError(
      "Challenge is invalid, already used, or expired.",
      "INVALID_OR_EXPIRED_CHALLENGE",
    );
  }
 
  // Note: we don't know the original expiresAt anymore (row is gone), so we
  // reconstruct the payload using the same nonce/domain/network/address the
  // client signed. Because the DB row's expiry was already validated above,
  // we don't need the expiry string to match exactly for signature purposes
  // — an attacker who alters it can't produce a valid signature. If you
  // want expiry itself covered by the DB gate rather than the payload gate,
  // you can drop `expires:` from the signed string; both approaches are
  // sound as long as at least one enforces it. Here the DB gate is the
  // authoritative expiry check, and the signed payload's job is to bind
  // domain/network/address/nonce so it can't be replayed elsewhere.
  const payload = buildSignedPayload({
    domain: AUTH_DOMAIN,
    network,
    stellarAddress,
    nonce,
    expiresAtIso: "", // not re-checked; see note above
  }).replace(/\nexpires: $/, ""); // drop the empty expiry line to match a
                                   // client that also omits it — adjust to
                                   // match your exact client-side template.
 
  let signatureValid = false;
  try {
    const keypair = Keypair.fromPublicKey(stellarAddress);
    signatureValid = keypair.verify(
      Buffer.from(payload, "utf8"),
      Buffer.from(signatureBase64, "base64"),
    );
  } catch {
    signatureValid = false;
  }
 
  if (!signatureValid) {
    throw new AuthChallengeError("Signature verification failed.", "INVALID_SIGNATURE");
  }
 
  return { success: true };
}
 
// ---------------------------------------------------------------------------
// Scheduled cleanup job — wire this into your existing BullMQ scheduler
// alongside the other periodic jobs (e.g. x-metrics-refresh).
// ---------------------------------------------------------------------------
 
export async function pruneExpiredAuthChallenges(): Promise<{ deleted: number }> {
  const { count } = await prisma.authChallenge.deleteMany({
    where: { expiresAt: { lte: new Date() } },
  });
  return { deleted: count };
}
 
// Exported for unit tests that need to exercise constant-time comparison
// logic directly (e.g. testing any future shared-secret / HMAC checks).
export const __testing = { constantTimeStringEqual, buildSignedPayload };
 
