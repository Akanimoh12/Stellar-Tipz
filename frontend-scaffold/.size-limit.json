[
  {
    "name": "Main Bundle",
    "path": "dist/assets/index-*.js",
    "limit": "200 KB",
    "gzip": true
  },
  {
    "name": "Vendor Bundle",
    "path": "dist/assets/vendor-*.js",
    "limit": "300 KB",
    "gzip": true
  },
  {
    "name": "Landing Page",
    "path": "dist/assets/landing-*.js",
    "limit": "100 KB",
    "gzip": true
  },
  {
    "name": "Transactions Page",
    "path": "dist/assets/transactions-*.js",
    "limit": "250 KB",
    "gzip": true
  },
  {
    "name": "Profile Page",
    "path": "dist/assets/profile-*.js",
    "limit": "150 KB",
    "gzip": true
  },
  {
    "name": "Per-route Chunks",
    "path": "dist/assets/*.js",
    "limit": "50 KB",
    "gzip": true,
    "ignore": ["index-*.js", "vendor-*.js", "landing-*.js", "transactions-*.js", "profile-*.js"]
  }
]
