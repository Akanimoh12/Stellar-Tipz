#!/usr/bin/env sh
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Refuse private environment files, but allow documented templates.
if printf '%s\n' "$staged" | grep -E '(^|/)\.env($|\.[^.]+$)' | grep -Ev '(^|/)\.env\.(example|sample|template)$' | grep -q .; then
  echo 'ERROR: A private .env file is staged.' >&2
  exit 1
fi

# Inspect index content rather than potentially different working-tree content.
printf '%s\n' "$staged" | while IFS= read -r path; do
  [ -n "$path" ] || continue
  if git show ":$path" 2>/dev/null | grep -Eq '(PRIVATE_KEY|SECRET_KEY|API_KEY|ACCESS_TOKEN|PASSWORD)[[:space:]]*=[[:space:]]*[^[:space:]]{8,}'; then
    echo "ERROR: Possible secret staged in $path" >&2
    exit 1
  fi
done

if printf '%s\n' "$staged" | grep -Eq '^contracts/.*\.rs$'; then
  (cd contracts && cargo fmt --all -- --check)
fi

if printf '%s\n' "$staged" | grep -Eq '^frontend-scaffold/src/'; then
  (cd frontend-scaffold && npx --no-install lint-staged)
fi
if printf '%s\n' "$staged" | grep -Eq '^backend/'; then
  (cd backend && npx --no-install lint-staged)
fi
